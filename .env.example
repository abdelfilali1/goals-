# Postgres connection. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/progress?schema=public"

# The single password that unlocks the app
APP_PASSWORD="change-me"

# Random string, 32+ characters, used to sign the session cookie
SESSION_SECRET="replace-with-a-long-random-string-of-32-plus-chars"
